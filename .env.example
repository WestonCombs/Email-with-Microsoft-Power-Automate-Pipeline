# Optional fallback for Email Sorter Settings.
# The app uses email_sorter_settings.json first. If a Settings field is blank,
# the matching value below is used.

GRAPH_MAIL_FOLDER=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=consumers
OPENAI_API_KEY=
DEBUG_MODE=0
HTML_CAPTURE_DEBUG_PORT=9223

# Optional: open saved email HTML in the same visible Chrome capture workflow
# used by PODs. Press Ctrl+Shift+P in Chrome once images look right.
# Values: 0/off, 1/on, or remote/images/problematic.
EMAIL_SORTER_ASSISTED_HTML_PDF=0
EMAIL_SORTER_ASSISTED_HTML_PDF_TIMEOUT_S=900
